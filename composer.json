{
    "name": "youvision/think-mailer",
    "description": "基于 PHPMailer 的 ThinkPHP 8 邮件发送组件，支持 SMTP、sendmail、mail 驱动及模板、附件、内嵌图片",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "thinkphp",
        "think-mailer",
        "phpmailer",
        "mailer",
        "mail",
        "smtp"
    ],
    "authors": [
        {
            "name": "youvision",
            "email": "youvision@example.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-openssl": "*",
        "phpmailer/phpmailer": "^6.9",
        "topthink/framework": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "youvision\\mailer\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "extra": {
        "think": {
            "services": [
                "youvision\\mailer\\Service"
            ],
            "config": {
                "mail": "config/mail.php"
            }
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}